<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>io.agentscope.examples</groupId>
    <artifactId>agentscope-dataagent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>AgentScope Java - DataAgent（独立学习版）</name>
    <description>
        多租户 DataAgent 产品：基于 HarnessAgent 构建的 Spring Boot 后端 + React SPA。 支持每用户工作空间隔离、分布式部署、侧通道适配器（ChatUI、钉钉、通用 Webhook） 以及管理员审批的能力市场。
    </description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <agentscope.version>2.0.0</agentscope.version>
        <revision>2.0.0-SNAPSHOT</revision>
        <spring.boot.version>3.3.5</spring.boot.version>
        <!-- agentscope 内部模块版本 -->
        <agentscope-harness.version>${agentscope.version}</agentscope-harness.version>
        <agentscope-extensions-channel-dingtalk.version>${agentscope.version}</agentscope-extensions-channel-dingtalk.version>
        <agentscope-extensions-skill-git-repository.version>${agentscope.version}</agentscope-extensions-skill-git-repository.version>
        <agentscope-extensions-nacos-skill.version>${agentscope.version}</agentscope-extensions-nacos-skill.version>
        <agentscope-extensions-redis.version>${agentscope.version}</agentscope-extensions-redis.version>
        <agentscope-extensions-mysql.version>${agentscope.version}</agentscope-extensions-mysql.version>
        <!-- 第三方依赖版本 -->
        <nacos-client.version>3.2.1-2026.03.30</nacos-client.version>
        <sqlite-jdbc.version>3.47.2.0</sqlite-jdbc.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <!-- 注意：不依赖 agentscope-dependencies-bom（该 BOM 未发布到公共仓库），
         所有 agentscope 依赖版本在此直接指定 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
            <version>${agentscope-harness.version}</version>
        </dependency>

        <!-- GA 2.0 将模型实现从 agentscope-core 拆分为独立提供商模块。 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-ollama</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- IM 通道实现：钉钉 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-channel-dingtalk</artifactId>
            <version>${agentscope-extensions-channel-dingtalk.version}</version>
        </dependency>

        <!-- Git Skill 仓库：GitDataAgentMarketplace 委托 clone/fetch 给 GitSkillRepository -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-skill-git-repository</artifactId>
            <version>${agentscope-extensions-skill-git-repository.version}</version>
        </dependency>

        <!-- Nacos Skill 仓库：ZIP 布局工具用于 fallback 路径 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-nacos-skill</artifactId>
            <version>${agentscope-extensions-nacos-skill.version}</version>
        </dependency>

        <!-- Nacos maintainer client: required for paged skill listing (SkillMaintainerService) -->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-maintainer-client</artifactId>
            <version>${nacos-client.version}</version>
        </dependency>

        <!--
          Optional: Redis-backed AgentScope runtime state for multi-instance / distributed sandbox mode.
          Marked optional=true so single-node deployments do not pull Redis client jars,
          and so that downstream apps can replace it with Lettuce/Redisson if desired.
          Activated at runtime by dataagent.runtime.redis.enabled=true.
        -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-redis</artifactId>
            <version>${agentscope-extensions-redis.version}</version>
            <optional>true</optional>
        </dependency>

        <!--
          Optional: JDBC-backed sandbox snapshot store. Uncomment + build online
          (mvn -U compile) to pull agentscope-extensions-mysql from the upstream repo.
          Then set dataagent.sandbox.snapshot.jdbc.enabled=true to route snapshots
          through your existing DataSource instead of Redis. Requires the
          jdbcSandboxSnapshotSpec(dataSource) bean in SandboxSnapshotConfig.
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-mysql</artifactId>
            <version>${agentscope-extensions-mysql.version}</version>
            <optional>true</optional>
        </dependency>
        -->

        <!--
          Optional: Spring Boot Redis starter.
          提供 RedisProperties / LettuceConnectionFactory 自动配置，让 application-redis.yml
          里的 spring.data.redis.* 直接生效，省掉手写连接参数的代码。
          optional=true：不开 redis profile 时不引入，保持单机部署零依赖。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- YAML parsing for subagent config -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- SQLite for FTS5 memory indexing (transitive use via harness extensions) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.47.2.0</version>
        </dependency>

        <!-- Spring Boot MVC (servlet HTTP + SSE) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistence store. Development, tests and production all use MySQL. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT (JJWT) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Jackson (JSON) - provided by Spring Boot -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Actuator (health, info) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          AgentScope 2.0's OtelTracingMiddleware only depends on the OpenTelemetry API.
          The SDK below provides a real tracer provider and lets the application persist a
          privacy-filtered span index for the runtime-records page.
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <version>1.37.0</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot fat JAR (classifier=exec keeps the thin JAR available as a library) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <mainClass>io.agentscope.dataagent.DataAgentApp</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Frontend (React SPA) 默认不绑定到 Maven 生命周期：
              后端构建（compile / package / test-compile）只需 JDK + Maven，无需 Node/npm。
              如需随 jar 一起构建前端并产出到 src/main/resources/static，
              激活 frontend profile：  mvn -Pfrontend package
            -->
        </plugins>
    </build>

    <!--
      Optional profile: 仅当需要用 Maven 一并构建 React 前端时才激活。
      默认不激活，避免每次 mvn package 都触发 npm install / build（依赖网络、耗时较长）。
      frontend/vite.config.ts 的 outDir 已指向 src/main/resources/static。
    -->
    <profiles>
        <profile>
            <id>frontend</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>1.15.1</version>
                        <configuration>
                            <workingDirectory>frontend</workingDirectory>
                            <installDirectory>target</installDirectory>
                            <nodeVersion>v20.19.2</nodeVersion>
                            <npmVersion>10.9.2</npmVersion>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-node-npm</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>install-node-and-npm</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>npm-install</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>install</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run build</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
